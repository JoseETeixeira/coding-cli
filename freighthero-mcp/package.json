{
  "name": "freighthero-mcp",
  "version": "1.0.0",
  "description": "MCP server for FreightHero codebase search via a local CocoIndex index",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "index:coco": "./.venv/bin/cocoindex update codebase_index.py",
    "index:coco:live": "./.venv/bin/cocoindex update codebase_index.py -L"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}