{
  "description": "Always-armed canonical auto-improvement check, plus optional optical compression of oversized Read results (Claude Code only)",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/auto-improvement-nudge.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/run_optical_compression_hook.py\""
          }
        ]
      }
    ]
  }
}
